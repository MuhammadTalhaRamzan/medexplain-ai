# Server
PORT=5000
NODE_ENV=development

# CORS — frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# OpenRouter (cloud AI provider — replaces local Ollama)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=MedExplain AI

# OCR — EasyOCR (Python), invoked from the Node backend via child_process
PYTHON_PATH=python3
EASYOCR_LANGUAGES=en
OCR_TIMEOUT_MS=20000

# Upload limits
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads
